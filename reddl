#!/usr/bin/env bash

set -euo pipefail

if [ -z "${1:-}" ]; then
    echo "Usage: $(basename "$0") <reddit-post-url>" >&2
    echo "Download a Reddit image in its source format to ~/Pictures, named after the post title." >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required" >&2
    exit 1
fi

url="$1"
ua="Mozilla/5.0 (X11; Linux x86_64; rv:136.0) Gecko/20100101 Firefox/136.0"

post_id=$(echo "$url" | sed -n 's|.*/comments/\([a-zA-Z0-9]*\).*|\1|p')

if [ -z "$post_id" ]; then
    echo "Could not extract post ID from URL" >&2
    exit 1
fi

# Reddit's HTML is JS-rendered and old.reddit.com now bounces logged-out
# clients to a login wall, so go through the JSON API instead. raw_json=1
# keeps HTML entities out of the values.
json_url="https://www.reddit.com/comments/${post_id}.json?raw_json=1"
page_url="https://www.reddit.com/comments/${post_id}/"

# Session cookies survive between runs, so the bot challenge below is
# normally solved once rather than on every download
jar="${XDG_CACHE_HOME:-$HOME/.cache}/reddl/cookies.txt"
mkdir -p "$(dirname "$jar")"
touch "$jar"
chmod 600 "$jar"

get() { curl -fsL -A "$ua" -b "$jar" -c "$jar" "$@"; }

# Fresh clients get an interstitial whose only real work is echoing back a
# doubled token; passing it is what mints the cookies the API accepts
solve_challenge() {
    local page tok sol
    page=$(get "$page_url" || true)
    tok=$(printf '%s' "$page" | sed -n 's/.*name="jsc_token" value="\([^"]*\)".*/\1/p' | head -1)
    sol=$(printf '%s' "$page" | sed -n 's/.*(async e=>e+e)("\([^"]*\)").*/\1/p' | head -1)
    [ -n "$tok" ] && [ -n "$sol" ] || return 1
    get -o /dev/null -G \
        --data-urlencode "solution=${sol}${sol}" \
        --data-urlencode "jsc_token=$tok" \
        -d "js_challenge=1" -d "jsc_orig_r=" \
        "$page_url"
}

json=$(get "$json_url" || true)
if ! echo "$json" | jq -e . >/dev/null 2>&1; then
    solve_challenge || true
    json=$(get "$json_url" || true)
fi

if ! echo "$json" | jq -e . >/dev/null 2>&1; then
    echo "Could not fetch post data — Reddit blocked the request" >&2
    exit 1
fi

post=$(echo "$json" | jq -c '.[0].data.children[0].data // empty')

if [ -z "$post" ]; then
    echo "Could not find post $post_id" >&2
    exit 1
fi

if [ "$(echo "$post" | jq -r '.is_gallery // false')" = "true" ]; then
    echo "Gallery posts are not supported: $url" >&2
    exit 1
fi

title=$(echo "$post" | jq -r '.title // empty')

if [ -z "$title" ]; then
    echo "Could not extract post title" >&2
    exit 1
fi

# url_overridden_by_dest is the link target; .url falls back to it for link
# posts and holds the permalink for self posts, which the extension check rejects
img_url=$(echo "$post" | jq -r '.url_overridden_by_dest // .url // empty')

if [ -z "$img_url" ]; then
    echo "Could not find image URL for post" >&2
    exit 1
fi

# preview.redd.it serves resized copies; the same path on i.redd.it is the
# original upload, and the sizing/signature params don't apply over there
case "$img_url" in
*preview.redd.it*)
    img_url="${img_url%%\?*}"
    img_url="${img_url/preview.redd.it/i.redd.it}"
    ;;
esac

ext="${img_url%%\?*}"
ext="${ext##*.}"
case "$ext" in
jpg | jpeg | png | gif | webp) ;;
*)
    echo "Post does not link to a direct image: $img_url" >&2
    exit 1
    ;;
esac

# slugify handles unicode transliteration; strip any " - r/sub" suffix first
slug=$(slugify "${title%% - r/*}")
if [ -z "$slug" ]; then
    slug="$post_id"
fi

output="$HOME/Pictures/${slug}.${ext}"
# Don't clobber an existing file from a different post with the same title
if [ -e "$output" ]; then
    output="$HOME/Pictures/${slug}-${post_id}.${ext}"
fi

mkdir -p "$HOME/Pictures"
curl -fsSL -A "$ua" -e "https://www.reddit.com/" -o "$output" "$img_url"

echo "$output"
